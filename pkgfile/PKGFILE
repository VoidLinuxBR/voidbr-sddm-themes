pkgname=voidbr-sddm-themes
pkgdesc="Sddm Themes for VoidBR"
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('MIT')
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
depends=(
	sddm
	qt6ct
	qt5-svg
	qt5-graphicaleffects
	qt5-quickcontrols
	qt5-quickcontrols2
	qt5-wayland
	qt6-wayland
	qt6-declarative    # QtQuick/QtQuick.Controls do tema voidbr-modern (greeter Qt6)
	qt6-svg            # ícones SVG do tema voidbr-modern
	sway               # compositor do greeter em modo Wayland (etc/sddm/sway-greeter.conf; substitui o weston)
	adwaita-icon-theme # cursor do greeter (etc/sddm.conf.d/cursor.conf: CursorTheme=Adwaita)
	polkit             # pkexec do voidbr-sddm-theme (aba "Tela de login" dos tweaks)
	file               # voidbr-sddm-theme: confere se o fundo escolhido é imagem
	util-linux         # voidbr-sddm-theme: setpriv (lê a imagem como o usuário)
)
backup=(
	/etc/sddm.conf
	/etc/sddm.conf.d/00-autologin
	/etc/sddm.conf.d/10-theme.conf
	/etc/sddm.conf.d/cursor.conf
	/etc/sddm.conf.d/numlock.conf
	/etc/sddm.conf.d/wayland.conf
)

package() {
	local dirs=("usr" "etc" "opt")
	#  echo "DESTDIR=$DESTDIR"
	#  echo "srcdir=$srcdir"
	#  echo "_pkgsrc=$_pkgsrc"

	for dir in "${dirs[@]}"; do
		if [ -d "${_pkgsrc}/${dir}" ]; then
			cp -a "${_pkgsrc}/${dir}" "$DESTDIR/"
		fi
	done
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	log "Finalizando instalação"
}

pre_upgrade() {
	log "Iniciando upgrade"
}

post_upgrade() {
	log "Finalizando upgrade"
}
